VITE_API_URL=http://localhost:3000/v1
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Firebase Web Push VAPID key
# Get it from: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# LocationIQ API key for location search + autocomplete
# Get it from: https://locationiq.com → Dashboard → Access Tokens
VITE_LOCATIONIQ_KEY=your_locationiq_key_here
